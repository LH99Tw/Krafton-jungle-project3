NODE_ENV=production
PORT=3000
APP_ORIGIN=https://five-days-web.duckdns.org
GAME_SERVER_PUBLIC_URL=wss://five-days-game.duckdns.org
ALLOWED_ORIGINS=https://five-days-web.duckdns.org
DATABASE_URL=postgresql://five_days_app:CHANGE_ME@postgres:5432/five_days
DATABASE_SSL=false
DB_POOL_MAX=10
DEV_AUTH_BYPASS=false
PUBLIC_PLAYTEST_ENABLED=true
AUTH_SESSION_ENCRYPTION_KEY=CHANGE_TO_32_BYTE_BASE64
GAME_TICKET_PRIVATE_KEY_BASE64=CHANGE_TO_PKCS8_PEM_BASE64
GAME_TICKET_ACTIVE_KID=production-v1
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=CHANGE_ME
COGNITO_CLIENT_ID=CHANGE_ME
COGNITO_CLIENT_SECRET=CHANGE_ME_OR_REMOVE_FOR_PUBLIC_CLIENT
COGNITO_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/CHANGE_ME
COGNITO_DOMAIN=https://CHANGE_ME.auth.ap-northeast-2.amazoncognito.com
COGNITO_REDIRECT_URI=https://five-days-web.duckdns.org/api/auth/callback
