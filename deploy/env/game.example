NODE_ENV=production
PORT=2567
DATABASE_URL=postgresql://five_days_app:CHANGE_ME@postgres:5432/five_days
DATABASE_SSL=false
DB_POOL_MAX=10
GAME_TICKET_PUBLIC_KEY_BASE64=CHANGE_TO_SPKI_PEM_BASE64
GAME_TICKET_ACTIVE_KID=production-v1
PROTOCOL_VERSION=10
FASTLANE_ENABLED=true
FASTLANE_HOST=0.0.0.0
FASTLANE_PORT=4433
FASTLANE_PUBLIC_URL=https://game.example.com/fastlane
FASTLANE_SECRET=CHANGE_TO_AT_LEAST_32_RANDOM_CHARACTERS
FASTLANE_CERT_PATH=/run/secrets/fastlane/tls.crt
FASTLANE_KEY_PATH=/run/secrets/fastlane/tls.key
FASTLANE_MAINTENANCE_MS=10000
MAX_ACTIVE_LOBBIES=100
MAX_ACTIVE_GAMES=8
MAX_LIVE_INVADERS=15
INVADER_MULTIRATE_PERCENT=10
INVADER_WARM_HZ=20
INVADER_COLD_HZ=10
MAX_WEBSOCKET_CONNECTIONS=300
MAX_HTTP_CONNECTIONS=350
WS_AUTH_PER_MINUTE=20
LOBBY_LIST_PER_MINUTE=30
SERVER_VERSION=CHANGE_TO_GIT_SHA
ALLOWED_ORIGINS=https://five-days-web.duckdns.org
