{
  "name": "five-days-to-demon-king",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "docker compose -f compose.local.yml up -d postgres",
    "local:down": "docker compose -f compose.local.yml down",
    "dev": "dotenv -e .env.local -- pnpm --parallel --filter @five-days/web --filter @five-days/game-server dev",
    "dev:web": "dotenv -e .env.local -- pnpm --filter @five-days/web dev",
    "dev:game": "dotenv -e .env.local -- pnpm --filter @five-days/game-server dev",
    "build": "pnpm -r build",
    "deadcode": "knip",
    "lint": "pnpm -r lint && eslint scripts",
    "map:generate": "pnpm --filter @five-days/web map:generate",
    "map:check": "pnpm --filter @five-days/web map:check",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm audit --prod --audit-level low && pnpm lint && pnpm typecheck && pnpm deadcode && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @five-days/db db:generate",
    "db:migrate": "dotenv -e .env.local -- pnpm --filter @five-days/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "knip": "^6.32.1",
    "typescript-eslint": "8.59.3"
  }
}
