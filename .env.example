NODE_ENV=development
APP_ORIGIN=http://localhost:3000
GAME_SERVER_PUBLIC_URL=ws://localhost:2567
DATABASE_URL=postgresql://five_days:five_days_local@localhost:55432/five_days
DATABASE_SSL=false
DB_POOL_MAX=10

DEV_AUTH_BYPASS=true
AUTH_SESSION_ENCRYPTION_KEY=<32-byte-base64>
GAME_TICKET_PRIVATE_KEY_BASE64=<pkcs8-pem-base64>
GAME_TICKET_PUBLIC_KEY_BASE64=<spki-pem-base64>
GAME_TICKET_ACTIVE_KID=local-v1
PROTOCOL_VERSION=1

COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback

ALLOWED_ORIGINS=http://localhost:3000
MINIMUM_PLAYERS=1
SERVER_VERSION=development
LOG_LEVEL=info
